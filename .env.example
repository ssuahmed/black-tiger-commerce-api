NODE_ENV=development
PORT=3001

# When true, OTP is always 123456 (generate + verify bypass). Keep false in staging/production.
USE_MOCK_OTP=true

# Next.js storefront origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000

# Optional Google Geocoding API key. Deterministic local stub is used when unset.
GOOGLE_MAPS_API_KEY=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long

# Optional: enable Redis (catalog cache, idempotency, Ask AI limits/sessions).
# Falls back to in-memory Maps when unset or unreachable.
REDIS_URL=redis://localhost:6379
# CATALOG_CACHE_TTL_SEC=300
# CONTENT_CACHE_TTL_SEC=300
# SHIPPING_CACHE_TTL_SEC=300
# ODOO_RPC_TIMEOUT_MS=30000

# Webhook HMAC (must match Odoo Settings → Black Tiger → webhook secret)
# ODOO_WEBHOOK_SECRET=black-tiger-dev-webhook-secret

# Odoo (M2+) — when live, content + catalog + checkout orders via JSON-RPC
# Local Docker: http://localhost:8069 / black_tiger_dev (see black-tiger-odoo/README.md)
# Client UAT: https://blacktigertest.odoodatabase.it.com / Black_test / commerce_api
# ODOO_MODE=live
# ODOO_URL=https://blacktigertest.odoodatabase.it.com
# ODOO_DB=Black_test
# Public base URL of this API (used for /v1/media/odoo image proxy links in catalog/CMS)
# PUBLIC_API_URL=http://localhost:3001
# ODOO_LOGIN=commerce_api
# ODOO_PASSWORD=

# Payment gateway: sandbox | paytabs | placeholder
# paytabs: Debit/Credit Card + Apple Pay via PayTabs HPP (enable Apple Pay on the merchant profile)
# PAYMENT_GATEWAY=sandbox

# PayTabs Hosted Payment Page (when PAYMENT_GATEWAY=paytabs)
# PAYTABS_PROFILE_ID=
# PAYTABS_SERVER_KEY=
# PAYTABS_BASE_URL=https://secure.paytabs.sa
# PAYTABS_CURRENCY=SAR
# PAYTABS_RETURN_URL=http://localhost:3000/cart/payment/return
# PAYTABS_CALLBACK_URL must be publicly reachable HTTPS in staging/prod (use ngrok/tunnel locally)
# PAYTABS_CALLBACK_URL=http://localhost:3001/internal/webhooks/paytabs

# Ask AI chat (M4): rules (keyword) | llm (OpenAI-compatible, including Ollama)
# Local Ollama example:
CHAT_PROVIDER=llm
CHAT_LLM_BASE_URL=http://localhost:11434/v1
CHAT_LLM_MODEL=llama3.2:3b
CHAT_LLM_API_KEY=ollama
CHAT_LLM_JSON_MODE=false
# OpenAI example:
# CHAT_LLM_BASE_URL=https://api.openai.com/v1
# CHAT_LLM_MODEL=gpt-4o-mini
# CHAT_LLM_API_KEY=
# CHAT_LLM_JSON_MODE=true
# Daily + burst caps (guest keyed by IP; user keyed by account id)
# CHAT_LIMIT_GUEST_DAILY=10
# CHAT_LIMIT_USER_DAILY=40
# CHAT_LIMIT_GUEST_BURST=5
# CHAT_LIMIT_USER_BURST=10
# CHAT_LIMIT_BURST_WINDOW_SEC=60

# Brevo SMTP — OTP + password-reset emails
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Must match a verified sender in Brevo
# SMTP_FROM=Black Tiger <noreply@your-domain.com>
# STOREFRONT_URL=http://localhost:3000

# WhatsApp Cloud API — primary channel for mobile OTP
# Leave unset / empty for local stub (logs Mock OTP (whatsapp): … when USE_MOCK_OTP=true)
# WHATSAPP_CLOUD_ENABLED=true
# WHATSAPP_CLOUD_API_VERSION=v21.0
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_OTP_TEMPLATE_NAME=authentication
# WHATSAPP_CLOUD_OTP_TEMPLATE_LANGUAGE=en
# Optional Meta WABA id (docs / future admin use)
# WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
# When true, OTP is 123456 even if USE_MOCK_OTP=false, and WhatsApp sends
# Meta's hello_world template with no body or parameters (connectivity probe).
# WHATSAPP_SEND_HELLO_FOR_TEST=false
